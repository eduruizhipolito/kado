# Cuenta patrocinadora: paga las reservas y las comisiones de todas las aperturas.
# En testnet se puede crear con friendbot. NUNCA commitear la clave real.
KADO_PATROCINADORA_SECRETA=S...

# Sal fija para derivar el keypair de cada Kado a partir de su codigo impreso.
# Cambiarla invalida todos los codigos ya emitidos.
KADO_SAL=cambia-esto-por-un-valor-aleatorio

# testnet | mainnet
KADO_RED=testnet

# Solo para desarrollo: origenes autorizados a pedir recursos de `next dev`.
# Hace falta para probar desde el celular por la IP de la red local; sin esto
# la pagina carga pero ningun boton funciona. Separar por comas.
KADO_DEV_ORIGENES=192.168.1.10
